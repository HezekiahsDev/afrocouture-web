# IPILE — Web Frontend Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001

# Public origin used for canonical links and social share images (no trailing slash).
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL is used automatically when this is unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# Support is on WhatsApp: the number in international format, digits only (shown on "Support" links)
NEXT_PUBLIC_SUPPORT_WHATSAPP=2348106681869
# Optional WhatsApp community group invite link (https://chat.whatsapp.com/...)
NEXT_PUBLIC_SUPPORT_WHATSAPP_GROUP=

# AI Studio: leave unset to show "coming soon"; set to true once Vertex is configured on the API
NEXT_PUBLIC_AI_STUDIO_ENABLED=

# Signs the web app's session cookie, which the proxy uses to keep each role on its own pages.
# Server-only (no NEXT_PUBLIC_). Use 32+ random characters, e.g. `openssl rand -base64 48`.
SESSION_SECRET=
# Optional: API URL for server-side calls (defaults to NEXT_PUBLIC_API_URL)
API_URL=
